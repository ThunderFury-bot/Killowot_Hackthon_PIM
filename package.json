{
  "name": "pim-woocommerce-system",
  "version": "1.0.0",
  "description": "AI-powered Product Information Management system for WooCommerce, enriched by Google Gemini",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n api,web -c cyan,green \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/server/tests/**/*.test.js"]
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@woocommerce/woocommerce-rest-api": "^1.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "engines": { "node": ">=18" }
}
